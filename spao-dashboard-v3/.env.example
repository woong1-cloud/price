# ─── SPAO 대시보드 V3 환경변수 ───────────────────────────────────────
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요 (.env.local 은 git 에 안 올라감)
#   cp .env.example .env.local
#
# Vercel / 회사 배포 시스템에서는 아래 3개를 "환경변수" 설정에 등록하세요.

# Supabase 프로젝트 URL
VITE_SUPABASE_URL=https://wtflegxxhmzcofojepuf.supabase.co

# Supabase anon(public) 키 — Supabase 대시보드 > Project Settings > API > anon public
# (이 키는 프론트엔드에 노출되어도 안전합니다. RLS 정책으로 보호됨)
VITE_SUPABASE_ANON_KEY=여기에_anon_public_키_붙여넣기

# 팀 공유 접속 비밀번호 (미설정 시 비밀번호 화면 없이 바로 입장)
VITE_ACCESS_PASSWORD=spao2026
